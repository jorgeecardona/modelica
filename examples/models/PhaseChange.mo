model PhaseChange "A steel bar heated, held and quenched: four phases, and the latent heat that puts them back into the temperature"
  parameter Real T_amb(unit = "K") = 300 "The shop floor";
  parameter Real m(unit = "kg") = 1.0 "The bar";
  parameter Real cp_body(unit = "J/(kg.K)") = 490 "Specific heat of ferrite, pearlite and martensite";
  parameter Real cp_aust(unit = "J/(kg.K)") = 620 "Specific heat of austenite -- the close-packed phase holds more";
  parameter Real Q_furnace(unit = "W") = 1400 "The furnace, while the bar is in it";
  parameter Real t_out(unit = "s") = 520 "When the bar comes out of the furnace";
  parameter Real t_quench(unit = "s") = 700 "When it goes into the oil";
  parameter Real UA_air(unit = "W/K") = 1.1 "Loss to the shop floor";
  parameter Real UA_oil(unit = "W/K") = 34 "Loss into the quenchant";
  parameter Real Ac1(unit = "K") = 996 "Where austenite starts to form on heating";
  parameter Real Ps(unit = "K") = 923 "Pearlite start on cooling";
  parameter Real Ms(unit = "K") = 596 "Martensite start";
  parameter Real n_aust = 2 "Avrami exponent for austenitisation";
  parameter Real k_aust(unit = "1/s") = 0.021 "JMAK rate constant for austenitisation";
  parameter Real n_pear = 2 "Avrami exponent for the pearlite reaction";
  parameter Real k_pear(unit = "1/s") = 0.0032 "JMAK rate constant for pearlite";
  parameter Real alpha(unit = "1/K") = 0.011 "Koistinen-Marburger constant";
  parameter Real L_aust(unit = "J/kg") = 84000.0 "Absorbed forming austenite";
  parameter Real L_mart(unit = "J/kg") = 21000.0 "Released forming martensite. See the note in the .toml: alpha * L_mart must stay under cp_body or the energy balance inverts";
  parameter Real HV_body(unit = "HV") = 170 "Vickers of the as-delivered ferrite-pearlite";
  parameter Real HV_aust(unit = "HV") = 250 "Vickers of austenite";
  parameter Real HV_pear(unit = "HV") = 220 "Vickers of the pearlite formed on cooling";
  parameter Real HV_mart(unit = "HV") = 720 "Vickers of martensite";
  Real T(unit = "K", start = 300, fixed = true) "Bar temperature";
  Real x_body(start = 1.0, fixed = true) "Ferrite and pearlite, as delivered";
  Real x_aust(start = 0.0, fixed = true) "Austenite";
  Real x_pear(start = 0.0, fixed = true) "Pearlite formed on cooling";
  Real x_mart(start = 0.0, fixed = true) "Martensite";
  Real tau_aust(unit = "s", start = 0.0, fixed = true) "Time spent above Ac1";
  Real tau_pear(unit = "s", start = 0.0, fixed = true) "Time spent in the pearlite window";
  Real r_aust(unit = "1/s") "Austenitisation rate";
  Real r_pear(unit = "1/s") "Pearlite rate";
  Real r_mart(unit = "1/s") "Martensite rate";
  Real cp(unit = "J/(kg.K)") "Specific heat of the mixture";
  Real Q(unit = "W") "Net heat into the bar";
  Real total "The four fractions. Physics says one; the solver is asked to agree";
  Real hardness(unit = "HV") "What the bar comes out at";
  Real celsius(unit = "degC") "The same temperature, for reading";
equation
  Q = (if time < t_out then Q_furnace else 0) - (if time < t_quench then UA_air else UA_oil) * (T - T_amb);
  cp = cp_body * (x_body + x_pear + x_mart) + cp_aust * x_aust;
  der(tau_aust) = if T > Ac1 then 1 else 0;
  der(tau_pear) = if T < Ps and T > Ms then 1 else 0;
  r_aust = n_aust * k_aust ^ n_aust * tau_aust ^ (n_aust - 1) * x_body;
  r_pear = if T < Ps and T > Ms then n_pear * k_pear ^ n_pear * tau_pear ^ (n_pear - 1) * x_aust else 0;
  r_mart = if T < Ms then -alpha * x_aust * der(T) else 0;
  der(x_body) = -r_aust;
  der(x_aust) = r_aust - r_pear - r_mart;
  der(x_pear) = r_pear;
  der(x_mart) = r_mart;
  m * cp * der(T) = Q - m * L_aust * r_aust + m * L_mart * r_mart;
  total = x_body + x_aust + x_pear + x_mart;
  hardness = HV_body * x_body + HV_aust * x_aust + HV_pear * x_pear + HV_mart * x_mart;
  celsius = T - 273.15;
end PhaseChange;
