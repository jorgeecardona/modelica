model AtwoodPendulum "A swinging Atwood machine on an elastic string, carrying a double pendulum -- five degrees of freedom, and chaos"
  parameter Real g(unit = "m/s2") = 9.81 "Gravity";
  parameter Real M(unit = "kg") = 2.1 "Counterweight -- vertical only, on the other side of the pulley";
  parameter Real m0(unit = "kg") = 1.0 "The swinging body, at the end of the string";
  parameter Real m1(unit = "kg") = 0.6 "First bob";
  parameter Real m2(unit = "kg") = 0.4 "Second bob";
  parameter Real l1(unit = "m") = 0.35 "First rod";
  parameter Real l2(unit = "m") = 0.3 "Second rod";
  parameter Real k(unit = "N/m") = 60.0 "String stiffness -- this is what makes it a *spring* Atwood machine";
  parameter Real L(unit = "m") = 1.5 "String length, unstretched";
  parameter Real track(unit = "m") = -0.45 "Where the counterweight's line sits, for the picture";
  Real z(unit = "m", start = 0.94335, fixed = true) "Counterweight descent below the pulley";
  Real r(unit = "m", start = 0.9, fixed = true) "Length of the swinging segment";
  Real th(unit = "rad", start = 0.5, fixed = true) "Its angle from the downward vertical";
  Real p1(unit = "rad", start = 0.9, fixed = true) "First rod, from the downward vertical";
  Real p2(unit = "rad", start = -0.6, fixed = true) "Second rod, from the downward vertical";
  Real vz(unit = "m/s", start = 0, fixed = true);
  Real vr(unit = "m/s", start = 0, fixed = true);
  Real om(unit = "rad/s", start = 0, fixed = true);
  Real w1(unit = "rad/s", start = 0, fixed = true);
  Real w2(unit = "rad/s", start = 0, fixed = true);
  Real stretch(unit = "m") "How much longer the string is than it wants to be";
  Real tension(unit = "N") "String tension -- the only thing the two sides say to each other";
  Real c1 "cos(p1 - th), and the five that follow it: the geometry, named once";
  Real s1;
  Real c2;
  Real s2;
  Real c12;
  Real s12;
  Real xc(unit = "m") "The counterweight, and then the four joints, for drawing";
  Real yc(unit = "m");
  Real xp(unit = "m");
  Real yp(unit = "m");
  Real x1(unit = "m");
  Real y1(unit = "m");
  Real x2(unit = "m");
  Real y2(unit = "m");
  Real energy(unit = "J") "Total energy -- conserved, and the only check on the algebra";
equation
  der(z) = vz;
  der(r) = vr;
  der(th) = om;
  der(p1) = w1;
  der(p2) = w2;
  c1 = cos(p1 - th);
  s1 = sin(p1 - th);
  c2 = cos(p2 - th);
  s2 = sin(p2 - th);
  c12 = cos(p1 - p2);
  s12 = sin(p1 - p2);
  stretch = z + r - L;
  tension = k * stretch;
  M * der(vz) = M * g - tension;
  (m0 + m1 + m2) * (der(vr) - om ^ 2 * r) = g * (m0 + m1 + m2) * cos(th) - tension + l1 * (m1 + m2) * (w1 ^ 2 * c1 + der(w1) * s1) + l2 * m2 * (w2 ^ 2 * c2 + der(w2) * s2);
  (m0 + m1 + m2) * (r * der(om) + 2 * om * vr) = -g * (m0 + m1 + m2) * sin(th) - l1 * (m1 + m2) * (c1 * der(w1) - s1 * w1 ^ 2) - l2 * m2 * (c2 * der(w2) - s2 * w2 ^ 2);
  l1 * (m1 + m2) * der(w1) + (m1 + m2) * (r * c1 * der(om) - s1 * der(vr) + om ^ 2 * r * s1 + 2 * om * vr * c1) + l2 * m2 * (c12 * der(w2) + s12 * w2 ^ 2) + g * (m1 + m2) * sin(p1) = 0;
  l2 * der(w2) + r * c2 * der(om) - s2 * der(vr) + om ^ 2 * r * s2 + 2 * om * vr * c2 + l1 * (c12 * der(w1) - s12 * w1 ^ 2) + g * sin(p2) = 0;
  xc = track;
  yc = -z;
  xp = r * sin(th);
  yp = -r * cos(th);
  x1 = xp + l1 * sin(p1);
  y1 = yp - l1 * cos(p1);
  x2 = x1 + l2 * sin(p2);
  y2 = y1 - l2 * cos(p2);
  energy = M * vz ^ 2 / 2 - M * g * z + m0 * (vr ^ 2 + om ^ 2 * r ^ 2) / 2 - g * m0 * r * cos(th) + m1 * (vr ^ 2 + om ^ 2 * r ^ 2 + l1 ^ 2 * w1 ^ 2 + 2 * l1 * om * w1 * r * c1 - 2 * l1 * vr * w1 * s1) / 2 - g * m1 * (r * cos(th) + l1 * cos(p1)) + m2 * (vr ^ 2 + om ^ 2 * r ^ 2 + l1 ^ 2 * w1 ^ 2 + l2 ^ 2 * w2 ^ 2 + 2 * l1 * l2 * w1 * w2 * c12 + 2 * l1 * om * w1 * r * c1 + 2 * l2 * om * w2 * r * c2 - 2 * l1 * vr * w1 * s1 - 2 * l2 * vr * w2 * s2) / 2 - g * m2 * (r * cos(th) + l1 * cos(p1) + l2 * cos(p2)) + k * stretch ^ 2 / 2;
end AtwoodPendulum;
