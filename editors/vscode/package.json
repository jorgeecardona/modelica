{
  "name": "pymodelica-scope",
  "displayName": "pymodelica Simulation Scope",
  "description": "Browse the pymodelica model corpus, simulated to its reference points, in an interactive chart inside VS Code.",
  "version": "0.0.1",
  "publisher": "jorgeecardona",
  "license": "MIT",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Visualization", "Data Science"],
  "activationEvents": [],
  "main": "./extension.js",
  "scripts": {
    "package": "pnpm dlx @vscode/vsce package",
    "install-local": "pnpm dlx @vscode/vsce package && code --install-extension pymodelica-scope-0.0.1.vsix"
  },
  "contributes": {
    "commands": [
      { "command": "pymodelica.openScope", "title": "pymodelica: Open Simulation Scope" }
    ]
  }
}
